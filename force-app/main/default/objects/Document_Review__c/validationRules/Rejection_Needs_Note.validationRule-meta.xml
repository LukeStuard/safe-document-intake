<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Rejection_Needs_Note</fullName>
    <active>true</active>
    <description>Every rejection has a reason on record.</description>
    <errorConditionFormula>AND(
    ISPICKVAL(Decision__c, "Rejected"),
    ISBLANK(Decision_Note__c)
)</errorConditionFormula>
    <errorDisplayField>Decision_Note__c</errorDisplayField>
    <errorMessage>Add a decision note explaining the rejection.</errorMessage>
</ValidationRule>
